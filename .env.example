# Copy to .env (root) and fill in. Never commit real values.
# `supabase start` prints local URL / keys; use those for local development.

# ---------------------------------------------------------------------------
# App (public: bundled into the client, safe to expose)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local: the "ANON_KEY" (or "PUBLISHABLE_KEY") printed by `supabase start` / `supabase status`.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Any MapLibre style URL. Default: OpenFreeMap "liberty" (no key required).
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Public web address of the app (e.g. https://wayfarer.app). Shared walk-list links use it, so
# links shared from iOS/Android open in any browser. Empty: the app's own link (web origin on
# web, wayfarer:// on native).
EXPO_PUBLIC_WEB_URL=
# Local city builder (D-079): the "serve" command of the data pipeline. "My city" asks it to build
# a city the app does not have yet (attractions with sources, then walking routes).
EXPO_PUBLIC_CITY_BUILDER_URL=http://127.0.0.1:8787
# Observability: leave empty to disable (no-op).
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# OAuth buttons to show (must also be enabled in Supabase Auth): "google", "apple" or "google,apple".
EXPO_PUBLIC_AUTH_PROVIDERS=
# Feature flags (D-065): "true" shows a feature that is built but hidden for now. Empty = hidden.
# Walk group chat ("Open group chat", /walk-chat) and paid plans (Upgrade, /plans, Settings →
# Subscription).
EXPO_PUBLIC_FEATURE_WALK_CHAT=
EXPO_PUBLIC_FEATURE_PAID_PLANS=
# Local mode (D-078): "true" opens the app without sign-in (no account: Trips and Profile are hidden).
EXPO_PUBLIC_LOCAL_MODE=

# ---------------------------------------------------------------------------
# Edge Functions (secret: set with `supabase secrets set`, never in the app)
# ---------------------------------------------------------------------------
ORS_API_KEY=
# Optional: an OSRM foot router to use instead of FOSSGIS' public one (D-087), e.g. a self-hosted
# instance, for heavy use. Empty: https://routing.openstreetmap.de/routed-foot (no key, fair use).
OSM_FOOT_URL=
EXCHANGE_RATES_BASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Email (D-066): welcome email + every auth email (Send Email Hook → auth-email function).
# Local defaults send to Mailpit (http://127.0.0.1:54324). Hosted: set these with
# `supabase secrets set` (RESEND_API_KEY, EMAIL_FROM, SEND_EMAIL_HOOK_SECRET, APP_URL).
# ---------------------------------------------------------------------------
# Production provider: a Resend API key (https://resend.com) for a verified sending domain.
# Empty = use MAILPIT_URL instead.
RESEND_API_KEY=
# Local provider: Mailpit's HTTP API as seen from the edge runtime container.
MAILPIT_URL=http://supabase_inbucket_wayfarer:8025
# Sender shown to users; production: an address on the domain verified in Resend.
EMAIL_FROM="Travelist <hello@travelist.local>"
# Standard Webhooks secret ("v1,whsec_<base64>") Auth signs hook calls with. Read by both
# supabase/config.toml ([auth.hook.send_email]) and the function. This value is for LOCAL use
# only; hosted, generate one in Dashboard → Authentication → Hooks and set it as a secret.
SEND_EMAIL_HOOK_SECRET=v1,whsec_dHJhdmVsaXN0LWxvY2FsLW9ubHktaG9vay1zZWNyZXQ=
# Public Supabase URL used in email links. Local only: the runtime's own SUPABASE_URL is the
# Docker-internal http://kong:8000. Hosted: leave empty (SUPABASE_URL is already public).
AUTH_PUBLIC_URL=http://127.0.0.1:54321
# Public web address of the app, for the welcome email's button. Empty: no button.
APP_URL=http://localhost:8081

# ---------------------------------------------------------------------------
# Auth providers. Local: read by supabase/config.toml (set enabled = true there).
# Hosted: configure in Supabase dashboard → Authentication → Providers.
# ---------------------------------------------------------------------------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Apple: "<services id>,<ios bundle id>" and the client secret JWT generated from your .p8 key.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# ---------------------------------------------------------------------------
# Data pipeline (Python)
# ---------------------------------------------------------------------------
# Contact info for the User-Agent sent to Wikidata / Overpass / Wikimedia APIs.
PIPELINE_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Local language model (D-084): the Ollama model of the trip planner and the suggested routes. Empty:
# qwen2.5:7b. `ollama pull gemma3:4b` first for Gemma (it answered Portuguese well and faster).
# ---------------------------------------------------------------------------
OLLAMA_MODEL=

# ---------------------------------------------------------------------------
# Optional partner integrations of the city-builder service (D-084). Each is OFF while empty.
# ---------------------------------------------------------------------------
# Sentry Agent Tracing: a gen_ai span (model, latency, tokens) per language-model call.
SENTRY_DSN=
# SerpApi: live web results, GET /places/web.
SERPAPI_API_KEY=
# ElevenLabs: narration, POST /narrate. The voice defaults to a stock multilingual one.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# MongoDB Atlas: the trip planner's long-term memory, GET /plan/history.
# The Atlas connection string, with or without credentials; with MONGODB_USER / MONGODB_PASSWORD set,
# those replace the user and the <db_password> placeholder (the password is percent-encoded).
MONGODB_URI=
MONGODB_USER=
MONGODB_PASSWORD=
