{
  "name": "wayfarer",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @wayfarer/mobile start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build:web": "turbo run build:web",
    "e2e": "pnpm --filter @wayfarer/mobile e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && node scripts/sync-shared.mjs --check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:demo": "node scripts/seed-demo.mjs",
    "functions:serve": "supabase functions serve --env-file .env",
    "sync:shared": "node scripts/sync-shared.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "db:types": "supabase gen types typescript --local --schema public > apps/mobile/src/lib/database.types.ts"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "supabase": "^2.118.0",
    "turbo": "^2.11.4",
    "typescript": "~6.0.3"
  }
}
